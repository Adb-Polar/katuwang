generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STUDENT_TUTOR
  STUDENT_LEARNER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum GradeLevel {
  GRADE_7
  GRADE_8
  GRADE_9
  GRADE_10
  GRADE_11
  GRADE_12
}

enum TopicCertificationStatus {
  PENDING // Assessment requested, not yet graded
  CERTIFIED // Tutor passed the topic assessment
}

enum SubjectArea {
  MATH
  ENGLISH
  SCIENCE
  FILIPINO
  ARALING_PANLIPUNAN
  TLE
  MAPEH
}

enum ClassStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  SUSPENDED
  BANNED
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  anonymousId  String     @unique // TUT-0001 or STU-0001
  firstName    String
  lastName     String
  email        String     @unique
  password     String // bcrypt hash
  role         Role
  gradeLevel   GradeLevel
  section      String
  contactInfo  String?
  consentGiven Boolean    @default(false)

  // Moderation
  status          AccountStatus @default(ACTIVE)
  statusReason    String?       @db.Text
  statusUpdatedAt DateTime?
  statusExpiresAt DateTime? // set when SUSPENDED with a duration; null = indefinite or not suspended

  // Misc
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Tutor-specific
  tutorProfile TutorProfile?

  // Relations
  enrollments  ClassEnrollment[] @relation("LearnerEnrollments")
  auditLogs    AuditLog[]

  @@map("users")
}

// ─── Tutor Profile ────────────────────────────────────────────────────────────

model TutorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Per-topic assessment requests/certifications, requested once a tutor is teaching a topic
  topicCertifications TopicCertification[]

  // Availability schedule (1 row per weekly slot)
  availability Availability[]

  // Classes created by this tutor
  classes TutorClass[]

  @@map("tutor_profiles")
}

// ─── Availability (weekly slots for a tutor) ───────────────────────────────────

model Availability {
  id             String       @id @default(cuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  day            String
  startTime      String
  endTime        String

  @@map("availabilities")
}

// ─── Topic Certification (per-topic assessment request/certification) ─────────
// A row only exists once a tutor has requested an assessment for that topic.

model TopicCertification {
  id             String                    @id @default(cuid())
  tutorProfileId String
  tutorProfile   TutorProfile              @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  subject        SubjectArea
  topic          String
  status         TopicCertificationStatus  @default(PENDING)
  requestedAt    DateTime                  @default(now())
  certifiedAt    DateTime?

  @@unique([tutorProfileId, subject, topic])
  @@map("topic_certifications")
}

// ─── ID Counter (for sequential anonymous IDs) ────────────────────────────────

model IdCounter {
  role  String @id // "TUTOR" or "LEARNER"
  count Int    @default(0)

  @@map("id_counters")
}

// ─── Tutor Class ─────────────────────────────────────────────────────────────

model TutorClass {
  id             String       @id @default(cuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  subject        SubjectArea
  description    String?      @db.Text
  scheduledAt    DateTime
  duration       Int          // duration in minutes (e.g. 60, 90)
  maxStudents    Int          @default(1) // Support for 1-on-1 or small group tutoring
  meetingLink    String?
  status          ClassStatus @default(SCHEDULED)
  suspendedReason String?     @db.Text
  suspendedUntil  DateTime? // set when SUSPENDED with a duration; null = indefinite or not suspended
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  topics      ClassTopic[]
  enrollments ClassEnrollment[]

  @@map("tutor_classes")
}

// ─── Class Topic (1 row per subtopic selected for a class) ───────────────────

model ClassTopic {
  id      String     @id @default(cuid())
  classId String
  class   TutorClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  topic   String

  @@unique([classId, topic])
  @@map("class_topics")
}

// ─── Class Enrollment ────────────────────────────────────────────────────────

model ClassEnrollment {
  id         String     @id @default(cuid())
  classId    String
  class      TutorClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  learnerId  String
  learner    User       @relation("LearnerEnrollments", fields: [learnerId], references: [id], onDelete: Cascade)
  enrolledAt DateTime   @default(now())

  @@unique([classId, learnerId])
  @@map("class_enrollments")
}

// ─── Audit Log (admin moderation action history) ──────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String
  reason     String?  @db.Text
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

// ─── Platform Setting (admin-configurable boolean flags) ──────────────────────

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}
