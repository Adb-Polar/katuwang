generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider                  = "prisma-erd-generator"
  output                    = "../docs/reference/erd.md"
  includeRelationFromFields = "true"
}

datasource db {
  provider = "mysql"
}

model User {
  id                       String                @id @default(cuid())
  anonymousId              String                @unique
  firstName                String
  lastName                 String
  email                    String                @unique
  password                 String
  recoveryEmail            String?
  role                     Role
  gradeLevel               GradeLevel
  section                  String
  contactInfo              String?
  consentGiven             Boolean               @default(false)
  status                   AccountStatus         @default(ACTIVE)
  statusReason             String?               @db.Text
  statusUpdatedAt          DateTime?
  statusExpiresAt          DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  emailVerifiedAt          DateTime?
  image                    String?               @db.Text
  imageKey                 String?
  profilePictureLocked     Boolean               @default(false)
  profilePictureUpdatedAt  DateTime?
  authoredQuestions        AssessmentQuestion[]  @relation("AuthoredQuestions")
  auditLogs                AuditLog[]
  chatbotMisses            ChatbotMiss[]
  reviewedClassAppeals     ClassAppeal[]         @relation("ReviewedClassAppeals")
  enrollments              ClassEnrollment[]     @relation("LearnerEnrollments")
  recommendationsIssued    ClassRecommendation[] @relation("ClassRecommendationsIssued")
  recommendationsReceived  ClassRecommendation[] @relation("ClassRecommendationsReceived")
  notifications            Notification[]
  passwordResetTokens      PasswordResetToken[]
  resolvedQuestionRequests QuestionRequest[]     @relation("ResolvedQuestionRequests")
  reportsFiled             Report[]              @relation("ReportsFiled")
  reviewedReports          Report[]              @relation("ReviewedReports")
  sessionTestAttempts      SessionTestAttempt[]  @relation("LearnerSessionTestAttempts")
  topicRequests            TopicRequest[]        @relation("LearnerTopicRequests")
  tutorProfile             TutorProfile?
  verificationTokens       VerificationToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

model TutorProfile {
  id                    String               @id @default(cuid())
  userId                String               @unique
  assessmentAttempts    AssessmentAttempt[]
  ownedQuestions        AssessmentQuestion[] @relation("OwnedQuestions")
  classAppeals          ClassAppeal[]
  questionRequests      QuestionRequest[]
  reportsReceived       Report[]             @relation("ReportsReceived")
  topicCertifications   TopicCertification[]
  directedTopicRequests TopicRequest[]       @relation("DirectedTopicRequests")
  classes               TutorClass[]
  user                  User                 @relation(fields: [userId], references: [id])

  @@map("tutor_profiles")
}

model TopicCertification {
  id             String                   @id @default(cuid())
  tutorProfileId String
  subject        String
  topic          String
  status         TopicCertificationStatus @default(PENDING)
  requestedAt    DateTime                 @default(now())
  certifiedAt    DateTime?
  reviewedAt     DateTime?
  reviewNote     String?                  @db.Text
  tutorProfile   TutorProfile             @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, subject, topic])
  @@map("topic_certifications")
}

model IdCounter {
  role  String @id
  count Int    @default(0)

  @@map("id_counters")
}

model Subject {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String   @unique
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  topics    Topic[]

  @@map("subjects")
}

model Topic {
  id        String   @id @default(cuid())
  subjectId String
  name      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, name])
  @@index([subjectId, active])
  @@map("topics")
}

model TutorClass {
  id                String                @id @default(cuid())
  code              String                @unique
  tutorProfileId    String
  subject           String
  gradeLevel        GradeLevel?
  description       String?               @db.Text
  maxStudents       Int                   @default(1)
  building          String?
  room              String?
  meetingLink       String?
  published         Boolean               @default(true)
  status            ClassStatus           @default(SCHEDULED)
  suspendedReason   String?               @db.Text
  suspendedUntil    DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  appeals           ClassAppeal[]
  enrollments       ClassEnrollment[]
  recommendations   ClassRecommendation[]
  sessions          ClassSession[]
  topics            ClassTopic[]
  reports           Report[]
  fulfilledRequests TopicRequest[]        @relation("FulfilledRequests")
  tutorProfile      TutorProfile          @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@index([tutorProfileId], map: "tutor_classes_tutorProfileId_fkey")
  @@map("tutor_classes")
}

model ClassTopic {
  id      String     @id @default(cuid())
  classId String
  topic   String
  class   TutorClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, topic])
  @@map("class_topics")
}

model ClassSession {
  id          String        @id @default(cuid())
  classId     String
  topic       String
  scheduledAt DateTime
  duration    Int
  status      SessionStatus @default(SCHEDULED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  class       TutorClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  test        SessionTest?

  @@index([classId])
  @@map("class_sessions")
}

model ClassEnrollment {
  id         String     @id @default(cuid())
  classId    String
  learnerId  String
  enrolledAt DateTime   @default(now())
  class      TutorClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  learner    User       @relation("LearnerEnrollments", fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([classId, learnerId])
  @@index([learnerId], map: "class_enrollments_learnerId_fkey")
  @@map("class_enrollments")
}

model TopicRequest {
  id                     String              @id @default(cuid())
  learnerId              String
  subject                String
  gradeLevel             GradeLevel
  note                   String?             @db.Text
  status                 TopicRequestStatus  @default(OPEN)
  fulfilledClassId       String?
  directedTutorProfileId String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  slots                  TopicRequestSlot[]
  topics                 TopicRequestTopic[]
  directedTutor          TutorProfile?       @relation("DirectedTopicRequests", fields: [directedTutorProfileId], references: [id])
  fulfilledClass         TutorClass?         @relation("FulfilledRequests", fields: [fulfilledClassId], references: [id])
  learner                User                @relation("LearnerTopicRequests", fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([status, subject])
  @@index([directedTutorProfileId, status])
  @@index([fulfilledClassId], map: "topic_requests_fulfilledClassId_fkey")
  @@index([learnerId], map: "topic_requests_learnerId_fkey")
  @@map("topic_requests")
}

model TopicRequestTopic {
  id        String       @id @default(cuid())
  requestId String
  topic     String
  request   TopicRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, topic])
  @@map("topic_request_topics")
}

model TopicRequestSlot {
  id        String       @id @default(cuid())
  requestId String
  day       String
  startTime String
  endTime   String
  request   TopicRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId], map: "topic_request_slots_requestId_fkey")
  @@map("topic_request_slots")
}

model ClassRecommendation {
  id          String     @id @default(cuid())
  classId     String
  learnerId   String
  adminId     String
  note        String?    @db.Text
  createdAt   DateTime   @default(now())
  dismissedAt DateTime?
  admin       User       @relation("ClassRecommendationsIssued", fields: [adminId], references: [id])
  class       TutorClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  learner     User       @relation("ClassRecommendationsReceived", fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([classId, learnerId])
  @@index([learnerId, dismissedAt])
  @@index([adminId], map: "class_recommendations_adminId_fkey")
  @@map("class_recommendations")
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  reason     String?  @db.Text
  createdAt  DateTime @default(now())
  admin      User     @relation(fields: [adminId], references: [id])

  @@index([adminId], map: "audit_logs_adminId_fkey")
  @@map("audit_logs")
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model AssessmentQuestion {
  id                  String                   @id @default(cuid())
  subject             String
  topic               String
  prompt              String                   @db.Text
  explanation         String?                  @db.Text
  active              Boolean                  @default(true)
  origin              QuestionOrigin           @default(BANK)
  createdById         String
  ownerTutorProfileId String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  attemptItems        AssessmentAttemptItem[]
  options             AssessmentOption[]
  createdBy           User                     @relation("AuthoredQuestions", fields: [createdById], references: [id])
  ownerTutorProfile   TutorProfile?            @relation("OwnedQuestions", fields: [ownerTutorProfileId], references: [id], onDelete: Cascade)
  sessionTestItems    SessionTestAttemptItem[]
  sessionTestLinks    SessionTestQuestion[]

  @@index([subject, topic, active, origin])
  @@index([ownerTutorProfileId])
  @@index([createdById], map: "assessment_questions_createdById_fkey")
  @@map("assessment_questions")
}

model AssessmentOption {
  id                    String                   @id @default(cuid())
  questionId            String
  text                  String                   @db.Text
  isCorrect             Boolean                  @default(false)
  position              Int
  selectedInItems       AssessmentAttemptItem[]  @relation("SelectedOption")
  question              AssessmentQuestion       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sessionTestSelections SessionTestAttemptItem[] @relation("SessionTestSelectedOption")

  @@unique([questionId, position])
  @@map("assessment_options")
}

model AssessmentAttempt {
  id             String                  @id @default(cuid())
  tutorProfileId String
  subject        String
  topic          String
  attemptNo      Int
  status         AssessmentAttemptStatus @default(IN_PROGRESS)
  questionCount  Int
  correctCount   Int                     @default(0)
  scorePercent   Int                     @default(0)
  passPercent    Int
  startedAt      DateTime                @default(now())
  submittedAt    DateTime?
  items          AssessmentAttemptItem[]
  tutorProfile   TutorProfile            @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, subject, topic, attemptNo])
  @@index([tutorProfileId, subject, topic])
  @@index([status])
  @@map("assessment_attempts")
}

model AssessmentAttemptItem {
  id               String             @id @default(cuid())
  attemptId        String
  questionId       String
  position         Int
  selectedOptionId String?
  isCorrect        Boolean?
  attempt          AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         AssessmentQuestion @relation(fields: [questionId], references: [id])
  selectedOption   AssessmentOption?  @relation("SelectedOption", fields: [selectedOptionId], references: [id])

  @@unique([attemptId, position])
  @@unique([attemptId, questionId])
  @@index([questionId], map: "assessment_attempt_items_questionId_fkey")
  @@index([selectedOptionId], map: "assessment_attempt_items_selectedOptionId_fkey")
  @@map("assessment_attempt_items")
}

model QuestionRequest {
  id             String                @id @default(cuid())
  tutorProfileId String
  subject        String
  topic          String
  note           String?               @db.Text
  status         QuestionRequestStatus @default(OPEN)
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?               @db.Text
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  resolvedBy     User?                 @relation("ResolvedQuestionRequests", fields: [resolvedById], references: [id])
  tutorProfile   TutorProfile          @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, subject, topic])
  @@index([status, subject])
  @@index([resolvedById], map: "question_requests_resolvedById_fkey")
  @@map("question_requests")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  message   String    @db.Text
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model ChatbotMiss {
  id        String   @id @default(cuid())
  message   String   @db.Text
  role      Role
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId], map: "chatbot_misses_userId_fkey")
  @@map("chatbot_misses")
}

model ClassAppeal {
  id             String            @id @default(cuid())
  classId        String
  tutorProfileId String
  reason         String            @db.Text
  status         ClassAppealStatus @default(PENDING)
  reviewNote     String?           @db.Text
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  class          TutorClass        @relation(fields: [classId], references: [id], onDelete: Cascade)
  reviewedBy     User?             @relation("ReviewedClassAppeals", fields: [reviewedById], references: [id])
  tutorProfile   TutorProfile      @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([classId])
  @@index([reviewedById], map: "class_appeals_reviewedById_fkey")
  @@index([tutorProfileId], map: "class_appeals_tutorProfileId_fkey")
  @@map("class_appeals")
}

model Report {
  id                     String            @id @default(cuid())
  reporterId             String
  targetType             ReportTargetType
  reportedTutorProfileId String?
  classId                String?
  details                String?           @db.Text
  status                 ReportStatus      @default(PENDING)
  resolutionNote         String?           @db.Text
  reviewedById           String?
  reviewedAt             DateTime?
  createdAt              DateTime          @default(now())
  violations             ReportViolation[]
  class                  TutorClass?       @relation(fields: [classId], references: [id], onDelete: Cascade)
  reportedTutorProfile   TutorProfile?     @relation("ReportsReceived", fields: [reportedTutorProfileId], references: [id], onDelete: Cascade)
  reporter               User              @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy             User?             @relation("ReviewedReports", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([classId], map: "reports_classId_fkey")
  @@index([reportedTutorProfileId], map: "reports_reportedTutorProfileId_fkey")
  @@index([reviewedById], map: "reports_reviewedById_fkey")
  @@map("reports")
}

model ReportViolation {
  id       String              @id @default(cuid())
  reportId String
  type     ReportViolationType
  report   Report              @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, type])
  @@map("report_violations")
}

model SessionTest {
  id           String                @id @default(cuid())
  sessionId    String                @unique
  title        String
  instructions String?               @db.Text
  status       SessionTestStatus     @default(DRAFT)
  publishedAt  DateTime?
  closedAt     DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  attempts     SessionTestAttempt[]
  questions    SessionTestQuestion[]
  session      ClassSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("session_tests")
}

model SessionTestQuestion {
  id            String             @id @default(cuid())
  sessionTestId String
  questionId    String
  position      Int
  question      AssessmentQuestion @relation(fields: [questionId], references: [id])
  sessionTest   SessionTest        @relation(fields: [sessionTestId], references: [id], onDelete: Cascade)

  @@unique([sessionTestId, position])
  @@unique([sessionTestId, questionId])
  @@index([questionId], map: "session_test_questions_questionId_fkey")
  @@map("session_test_questions")
}

model SessionTestAttempt {
  id             String                   @id @default(cuid())
  sessionTestId  String
  learnerId      String
  kind           SessionTestKind
  status         SessionTestAttemptStatus @default(IN_PROGRESS)
  totalQuestions Int
  correctCount   Int                      @default(0)
  scorePercent   Int                      @default(0)
  startedAt      DateTime                 @default(now())
  submittedAt    DateTime?
  items          SessionTestAttemptItem[]
  learner        User                     @relation("LearnerSessionTestAttempts", fields: [learnerId], references: [id], onDelete: Cascade)
  sessionTest    SessionTest              @relation(fields: [sessionTestId], references: [id], onDelete: Cascade)

  @@unique([sessionTestId, learnerId, kind])
  @@index([learnerId, kind])
  @@index([sessionTestId, kind, status])
  @@map("session_test_attempts")
}

model SessionTestAttemptItem {
  id               String             @id @default(cuid())
  attemptId        String
  questionId       String
  position         Int
  selectedOptionId String?
  isCorrect        Boolean?
  attempt          SessionTestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         AssessmentQuestion @relation(fields: [questionId], references: [id])
  selectedOption   AssessmentOption?  @relation("SessionTestSelectedOption", fields: [selectedOptionId], references: [id])

  @@unique([attemptId, position])
  @@unique([attemptId, questionId])
  @@index([questionId], map: "session_test_attempt_items_questionId_fkey")
  @@index([selectedOptionId], map: "session_test_attempt_items_selectedOptionId_fkey")
  @@map("session_test_attempt_items")
}

enum Role {
  ADMIN
  STUDENT_TUTOR
  STUDENT_LEARNER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING
  DECLINED
}

enum GradeLevel {
  GRADE_7
  GRADE_8
  GRADE_9
  GRADE_10
  GRADE_11
  GRADE_12
}

enum TopicCertificationStatus {
  PENDING
  CERTIFIED
  REJECTED
}

enum ClassStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  SUSPENDED
  BANNED
}

enum ClassAppealStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportTargetType {
  TUTOR
  CLASS
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum ReportViolationType {
  HARASSMENT_OR_BULLYING
  ANONYMITY_BREACH
  SOLICITING_PAYMENT
  DISCRIMINATION
  UNPROFESSIONAL_CONDUCT
  NO_SHOW_OR_ABSENCE
  MISLEADING_ACADEMIC_INFO
  MISLEADING_CLASS_INFO
  OFF_TOPIC_SESSIONS
  SPAM_OR_DUPLICATE
  SCHEDULE_ABUSE
  INAPPROPRIATE_CONTENT
  OTHER
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum TopicRequestStatus {
  OPEN
  ACCEPTED
  ENROLLED
  FULFILLED
  CANCELLED
}

enum AssessmentAttemptStatus {
  IN_PROGRESS
  PASSED
  FAILED
}

enum QuestionRequestStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum QuestionOrigin {
  BANK
  TUTOR
}

enum SessionTestStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SessionTestKind {
  PRE
  POST
}

enum SessionTestAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}
