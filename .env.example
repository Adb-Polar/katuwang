# Active database connection used by Prisma
# Switch targets with `pnpm db:local` or `pnpm db:cloud`
DATABASE_URL="mysql://root:@127.0.0.1:3306/katuwang_db"

# Local MySQL/MariaDB connection
LOCAL_DATABASE_URL="mysql://root:@127.0.0.1:3306/katuwang_db"

# Cloud database connection (e.g. Aiven MySQL 8)
CLOUD_DATABASE_URL="mysql://avnadmin:YOUR_PASSWORD@katuwangdb-bicol-ace1.l.aivencloud.com:24446/defaultdb?ssl-mode=REQUIRED&connectTimeout=30000"

# Optional trusted CA certificate for TLS verification (e.g. Aiven Project CA)
# Paste contents or specify a path to the .pem file:
# AIVEN_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# AIVEN_CA_CERT_PATH="/etc/secrets/aiven-ca.pem"

# NextAuth configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"

# SMTP configuration for email verification & notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-app-password"
MAIL_FROM="Katuwang <noreply@example.com>"

# UploadThing configuration for user profile pictures
UPLOADTHING_TOKEN="your_uploadthing_token_here"

# Transactional email over HTTPS (recommended for Render free services)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Katuwang

# Require verification for new public signups without locking legacy accounts
REQUIRE_SIGNUP_EMAIL_VERIFICATION=true
